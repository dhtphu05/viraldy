APP_NAME=Viraldy
APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+asyncpg://viraldy:viraldy@localhost:5432/viraldy
DATABASE_SYNC_URL=postgresql+psycopg://viraldy:viraldy@localhost:5432/viraldy

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

AUTH_MODE=local_test
AUTH_DISABLED=false
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=viraldy-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_EXPIRY_SECONDS=900

MAX_DECLARED_UPLOAD_MB=250
ALLOWED_UPLOAD_MIME_TYPES=video/mp4,video/quicktime,image/jpeg,image/png
MAX_MEDIA_DURATION_SECONDS=180

AI_MODE=fixture
AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_API_KEY=
AI_TEXT_MODEL=
AI_VISION_MODEL=
ASR_PROVIDER=fixture
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
OCR_PROVIDER=fixture
OCR_MODEL=
AI_SUPPORTS_JSON_SCHEMA=true
AI_SUPPORTS_IMAGE_URL=true
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

GIT_SHA=
RELEASE_VERSION=
