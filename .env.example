# Run make setup-env to create missing private local env files and random auth secrets.
APP_NAME=Viraldy
APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
VITE_API_BASE_URL=http://localhost:8000/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql+asyncpg://viraldy:viraldy@localhost:5432/viraldy
DATABASE_SYNC_URL=postgresql+psycopg://viraldy:viraldy@localhost:5432/viraldy

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
TIKTOK_COMMERCIAL_API_ENABLED=false
TIKTOK_COMMERCIAL_CLIENT_KEY=
TIKTOK_COMMERCIAL_CLIENT_SECRET=
TIKTOK_COMMERCIAL_MEDIA_PERSISTENCE_ALLOWED=false
TIKTOK_COMMERCIAL_DIRECT_STREAM_ALLOWED=false
TIKTOK_COMMERCIAL_REQUEST_TIMEOUT_SECONDS=20
TIKTOK_COMMERCIAL_MAX_RETRIES=2
TIKTOK_COMMERCIAL_CACHE_TTL_SECONDS=300
TIKTOK_MARKET_INTELLIGENCE=false
CREATIVE_FAMILY=false
MARKET_PATTERN_EVIDENCE=false
BATCH_CREATIVE_REVIEW=false
SHARE_MARKET_SNAPSHOT=false
TIKTOK_MARKET_SEARCH_LIMIT=100
TIKTOK_MARKET_ANALYSIS_LIMIT=20
TIKTOK_MARKET_SCORE_LIMIT=20
TIKTOK_MARKET_ADAPTATION_LIMIT=10
TIKTOK_MARKET_BATCH_SIZE_LIMIT=25
FREE_MARKET_SEARCHES_PER_PERIOD=10
FREE_CREATIVE_ANALYSES=3
FREE_SINGLE_SCORE_REVIEWS=3
FREE_PRODUCT_ADAPTATIONS=3
FREE_BATCH_SIZE=3
PRODUCT_CRAWL_MAX_CONCURRENCY=2
PRODUCT_CRAWL_PUBLIC_BASE_URL=http://localhost:8000
PRODUCT_CRAWL_OUTPUT_DIR=
PRODUCT_CRAWL_REVIEW_CLIP_TTL_HOURS=6

AUTH_MODE=password
AUTH_DISABLED=false
# Generated by setup-env for the backend only; never use a VITE_ prefix for secrets.
AUTH_JWT_SECRET=
# Separate shared secret on backend + frontend server for authenticated client-IP forwarding.
AUTH_PROXY_SECRET=
AUTH_JWT_ISSUER=viraldy
AUTH_JWT_AUDIENCE=viraldy-api
AUTH_ACCESS_TOKEN_SECONDS=900
AUTH_REFRESH_TOKEN_DAYS=30
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
# OIDC_JWKS_URL=
# OIDC_AUTHORIZATION_URL=
# OIDC_TOKEN_URL=
OIDC_CLIENT_ID=
OIDC_SCOPES=["openid","profile","email","phone","offline_access"]
# OIDC_REGISTRATION_URL=
# OIDC_END_SESSION_URL=
# OIDC_REVOCATION_URL=
OIDC_ALLOWED_ALGORITHMS=["RS256"]
OIDC_JWKS_CACHE_SECONDS=300
OIDC_REQUIRE_VERIFIED_PHONE=false

# Frontend server runtime environment (set in the hosting platform or shell).
# Use the exact HTTPS frontend origin behind a production reverse proxy.
AUTH_PUBLIC_ORIGIN=http://localhost:5173
# Enable only behind an ingress that overwrites client-supplied forwarding headers.
AUTH_TRUST_PROXY_HEADERS=false
# Only for confidential OIDC clients configured for client_secret_post.
# Leave empty for the public PKCE client used by the local Keycloak setup.
AUTH_CLIENT_SECRET=

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=viraldy-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_EXPIRY_SECONDS=900

MAX_DECLARED_UPLOAD_MB=250
ALLOWED_UPLOAD_MIME_TYPES=["video/mp4","video/quicktime","image/jpeg","image/png"]
MAX_MEDIA_DURATION_SECONDS=180

AI_MODE=fixture
AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_API_KEY=
AI_TEXT_MODEL=
AI_VISION_MODEL=
ASR_PROVIDER=fixture
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
OCR_PROVIDER=fixture
OCR_MODEL=
AI_SUPPORTS_JSON_SCHEMA=true
AI_SUPPORTS_IMAGE_URL=true
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
# AI_MAX_OUTPUT_TOKENS=

# Smart Remake (8s / 16s vertical creative reconstruction)
SMART_REMAKE_ENABLED=true
SMART_REMAKE_MAX_REFERENCE_VIDEO_BYTES=31457280
SMART_REMAKE_MAX_PRODUCT_IMAGE_BYTES=10485760
SMART_REMAKE_OUTPUT_DIR=./outputs/smart-remake
SMART_REMAKE_ASSET_TTL_SECONDS=86400
SMART_REMAKE_LOCAL_OUTPUT_TTL_SECONDS=604800
SMART_REMAKE_GEMINI_MODEL=gemini-2.5-flash
SMART_REMAKE_GEMINI_TIMEOUT_SECONDS=300
SMART_REMAKE_RENDER_TEXT_OVERLAYS=false
SMART_REMAKE_UNIFICALLY_SCENE_REFERENCE=false
SMART_REMAKE_UNIFICALLY_SEED=
SMART_REMAKE_FFMPEG_PATH=
SMART_REMAKE_FFPROBE_PATH=
GEMINI_API_KEY=
FLOWKIT_URL=http://127.0.0.1:8100
UNIFICALLY_API_KEY=
UNIFICALLY_API_BASE_URL=https://api.unifically.com
UNIFICALLY_FILES_BASE_URL=https://files.storagecdn.online
UNIFICALLY_IMAGE_MODEL=google/nano-banana-2-lite
UNIFICALLY_VIDEO_MODEL=google/veo-3.1-lite-relaxed
UNIFICALLY_POLL_INTERVAL_SECONDS=5
UNIFICALLY_POLL_TIMEOUT_SECONDS=900
# Smart Remake KIE Veo 3.1 Lite + direct OpenAI images (backend/worker only).
KIE_API_KEY=
KIE_POLL_INTERVAL_SECONDS=5
KIE_POLL_TIMEOUT_SECONDS=900
OPENAI_API_KEY=
SMART_REMAKE_OPENAI_IMAGE_QUALITY=max
# P0: reviewed conservative USD ceilings per physical provider request; no price defaults.
# Leave blank during offline preparation. Missing bounds block paid submissions.
SMART_REMAKE_P0_MAX_ANALYSIS_USD=
SMART_REMAKE_P0_MAX_IMAGE_USD=
SMART_REMAKE_P0_MAX_VIDEO_USD=
SMART_REMAKE_P0_MAX_INSPECTION_USD=
PUBLIC_BASE_URL=http://127.0.0.1:8000
ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

GIT_SHA=
RELEASE_VERSION=
